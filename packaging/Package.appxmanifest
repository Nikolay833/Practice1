<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the MSIX manifest. packaging/build-msix.ps1 fills in {{VERSION}} and {{ARCH}} and writes the result as
  AppxManifest.xml next to Dropshelf.exe, once per architecture.

  Identity/Publisher must be exactly the subject of the certificate that signs the bundle (packaging/sign-msix.ps1).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 desktop6 rescap">

  <Identity Name="Dropshelf" Publisher="CN=Dropshelf" Version="{{VERSION}}" ProcessorArchitecture="{{ARCH}}" />

  <Properties>
    <DisplayName>Dropshelf</DisplayName>
    <PublisherDisplayName>Dropshelf</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- Writes to HKCU and %LOCALAPPDATA% go to the real locations, not into a per-package copy: the portable version's autostart
         cleanup and the data under %LOCALAPPDATA%\Dropshelf stay shared with the portable version. Needs the unvirtualizedResources capability. -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="Dropshelf.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Dropshelf"
        Description="An Apple-style island at the top of your screen with live activities, a drop basket and clipboard history."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Start with Windows. Shown (and switchable) in Task Manager > Startup apps; the app's own setting asks for it. -->
        <uap5:Extension Category="windows.startupTask" Executable="Dropshelf.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="DropshelfStartup" Enabled="true" DisplayName="Dropshelf" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A normal desktop app (WPF) running with package identity. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Required for turning off the registry / file system write virtualization above. -->
    <rescap:Capability Name="unvirtualizedResources" />
    <!-- Windows calendars (appointment store), read-only. -->
    <uap:Capability Name="appointments" />
    <!-- Windows notifications shown on the island. The user still has to allow it in a Windows prompt. -->
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>
</Package>
