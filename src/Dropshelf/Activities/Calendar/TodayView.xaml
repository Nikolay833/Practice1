<UserControl x:Class="Dropshelf.Activities.Calendar.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Weather card (filled in code) -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="14,10">
            <Grid x:Name="WeatherHost"/>
        </Border>

        <!-- Agenda (filled in code) -->
        <ScrollViewer x:Name="AgendaScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Agenda" Margin="0,0,6,0"/>
        </ScrollViewer>
    </Grid>
</UserControl>
