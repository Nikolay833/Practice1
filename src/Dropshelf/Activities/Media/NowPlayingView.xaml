<UserControl x:Class="Dropshelf.Activities.Media.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Transport control: a bare white glyph that dims while pressed (no button chrome, like the Dynamic Island). -->
        <Style x:Key="Transport" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Media scrubber: a thin track with a white fill; the knob only appears while the pointer is over it. -->
        <Style x:Key="MediaFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="White" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="Root" Height="16" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#3DFFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource MediaFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Knob" Width="10" Height="10" Opacity="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource MediaRest}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Art, title, artist and the source app -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="10" Background="{StaticResource FillBrush}" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Image x:Name="ArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,50,50" RadiusX="10" RadiusY="10"/>
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource TextPrimary}" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Style="{StaticResource TextSecondary}" FontSize="13"
                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>
            <TextBlock x:Name="SourceText" Grid.Column="2" Style="{StaticResource TextSecondary}" FontSize="11" MaxWidth="140"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Margin="0,2,0,0"/>
        </Grid>

        <!-- Scrubber -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedText" Grid.Column="0" Style="{StaticResource TextSecondary}" FontSize="11"
                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Text="0:00"/>
            <Slider x:Name="Scrubber" Grid.Column="1" Style="{StaticResource MediaSlider}" Minimum="0" Maximum="1"
                    IsMoveToPointEnabled="True" Margin="4,0" VerticalAlignment="Center" IsEnabled="False"/>
            <TextBlock x:Name="RemainingText" Grid.Column="2" Style="{StaticResource TextSecondary}" FontSize="11"
                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0:00"/>
        </Grid>

        <!-- Transport -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="PreviousButton" Content="&#xE892;" Style="{StaticResource Transport}" ToolTip="Previous" Click="Previous_Click"/>
            <Button x:Name="PlayPauseButton" Content="&#xE768;" Style="{StaticResource Transport}" FontSize="22" Margin="18,0"
                    ToolTip="Play / pause" Click="PlayPause_Click"/>
            <Button x:Name="NextButton" Content="&#xE893;" Style="{StaticResource Transport}" ToolTip="Next" Click="Next_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
