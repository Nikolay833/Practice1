<UserControl x:Class="Dropshelf.Activities.Media.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Transport control: a bare white vector glyph that dims while pressed (no button chrome). -->
        <Style x:Key="Transport" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" CenterX="24" CenterY="20"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded-square glass button at the ends of the transport row (shuffle / repeat); accent glyph when on. -->
        <Style x:Key="SideButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#26FFFFFF" CornerRadius="11">
                            <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress / volume bar: a 6 px rounded track with a white fill; the knob only shows while pointing at it. -->
        <Style x:Key="BarFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" Background="White" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MediaSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" Background="Transparent">
                            <Border Height="6" CornerRadius="3" Background="#40FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource BarFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Knob" Width="12" Height="12" Opacity="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource BarRest}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Player ===== -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Art, title, artist, live waveform -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="58" Height="58" CornerRadius="13" Background="{StaticResource FillBrush}">
                    <Grid>
                        <TextBlock Text="&#xEC4F;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Image x:Name="ArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,58,58" RadiusX="13" RadiusY="13"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource TextPrimary}" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistText" Style="{StaticResource TextSecondary}" FontSize="13"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <Grid x:Name="WaveHost" Grid.Column="2" Width="23" Height="20" VerticalAlignment="Center" Margin="0,0,2,0"/>
            </Grid>

            <!-- Progress: elapsed, bar, remaining -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ElapsedText" Grid.Column="0" Style="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" MinWidth="30" Text="0:00"/>
                <Slider x:Name="Scrubber" Grid.Column="1" Style="{StaticResource MediaSlider}" Minimum="0" Maximum="1"
                        IsMoveToPointEnabled="True" Margin="10,0" VerticalAlignment="Center" IsEnabled="False"/>
                <TextBlock x:Name="RemainingText" Grid.Column="2" Style="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" TextAlignment="Right" MinWidth="34" Text="-0:00"/>
            </Grid>

            <!-- Transport -->
            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                <ToggleButton x:Name="ShuffleButton" Style="{StaticResource SideButton}" Content="&#xE8B1;" HorizontalAlignment="Left"
                              ToolTip="Shuffle" Click="Shuffle_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PreviousButton" Style="{StaticResource Transport}" ToolTip="Previous" Click="Previous_Click">
                        <Path Fill="White" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M12,0 L0,8.5 L12,17 Z M25,0 L13,8.5 L25,17 Z"/>
                    </Button>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource Transport}" Margin="14,0" ToolTip="Play / pause" Click="PlayPause_Click">
                        <Grid>
                            <Path x:Name="PauseIcon" Fill="White" Data="M1.5,0 H5.5 A1.5,1.5 0 0 1 7,1.5 V20.5 A1.5,1.5 0 0 1 5.5,22 H1.5 A1.5,1.5 0 0 1 0,20.5 V1.5 A1.5,1.5 0 0 1 1.5,0 Z M12.5,0 H16.5 A1.5,1.5 0 0 1 18,1.5 V20.5 A1.5,1.5 0 0 1 16.5,22 H12.5 A1.5,1.5 0 0 1 11,20.5 V1.5 A1.5,1.5 0 0 1 12.5,0 Z"/>
                            <Path x:Name="PlayIcon" Fill="White" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed"
                                  Data="M1,0 L19,11 L1,22 Z"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource Transport}" ToolTip="Next" Click="Next_Click">
                        <Path Fill="White" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M0,0 L12,8.5 L0,17 Z M13,0 L25,8.5 L13,17 Z"/>
                    </Button>
                </StackPanel>
                <ToggleButton x:Name="RepeatButton" Style="{StaticResource SideButton}" Content="&#xE8EE;" HorizontalAlignment="Right"
                              ToolTip="Repeat" Click="Repeat_Click"/>
            </Grid>
        </Grid>

        <!-- Divider -->
        <Border Grid.Column="1" Width="1" Margin="22,4" Background="{StaticResource StrokeBrush}"/>

        <!-- ===== Right column: where it plays from, the album, the volume ===== -->
        <StackPanel Grid.Column="2" VerticalAlignment="Top">
            <TextBlock Text="Playing From" Style="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource FillBrush}">
                    <TextBlock x:Name="SourceInitial" Style="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="150">
                    <TextBlock x:Name="SourceText" Style="{StaticResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AlbumText" Style="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Volume" Style="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,0"/>
            <Grid x:Name="VolumeRow" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE993;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource MediaSlider}" Minimum="0" Maximum="1"
                        IsMoveToPointEnabled="True" Margin="8,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="&#xE995;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
