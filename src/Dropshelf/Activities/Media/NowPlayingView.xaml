<UserControl x:Class="Dropshelf.Activities.Media.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Soft glow from the art: a 24 px decode stretched over the page is a cheap, smooth blur. -->
        <Border CornerRadius="14" ClipToBounds="True" IsHitTestVisible="False">
            <Border.OpacityMask>
                <RadialGradientBrush Center="0.1,0.5" GradientOrigin="0.1,0.5" RadiusX="0.85" RadiusY="1.3">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
            </Border.OpacityMask>
            <Image x:Name="GlowImage" Stretch="UniformToFill" Opacity="0.42" RenderOptions.BitmapScalingMode="Linear"/>
        </Border>

        <Grid Margin="8,2,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Album art -->
            <Border Grid.Column="0" Width="100" Height="100" CornerRadius="12" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="30"
                               Foreground="{StaticResource TextDisabledBrush}"/>
                    <Image x:Name="ArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,6,0" VerticalAlignment="Center">
                <TextBlock x:Name="SourceText" Style="{StaticResource TextSecondary}" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TitleText" Style="{StaticResource TextPrimary}" FontSize="17" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                <TextBlock x:Name="ArtistText" Style="{StaticResource TextSecondary}" FontSize="13"
                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedText" Grid.Column="0" Style="{StaticResource TextSecondary}" FontSize="11"
                               VerticalAlignment="Center" Text="0:00"/>
                    <Slider x:Name="Scrubber" Grid.Column="1" Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                            Margin="4,0" VerticalAlignment="Center" IsEnabled="False"/>
                    <TextBlock x:Name="RemainingText" Grid.Column="2" Style="{StaticResource TextSecondary}" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Text="0:00"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Button x:Name="PreviousButton" Content="&#xE892;" Style="{StaticResource IconButton}" Width="36" Height="30"
                            FontSize="15" ToolTip="Previous" Click="Previous_Click"/>
                    <Button x:Name="PlayPauseButton" Content="&#xE768;" Style="{StaticResource AccentButton}" Width="52" Height="30"
                            Padding="0" FontFamily="{StaticResource IconFont}" FontSize="15" Margin="8,0"
                            ToolTip="Play / pause" Click="PlayPause_Click"/>
                    <Button x:Name="NextButton" Content="&#xE893;" Style="{StaticResource IconButton}" Width="36" Height="30"
                            FontSize="15" ToolTip="Next" Click="Next_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
