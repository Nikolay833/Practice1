<UserControl x:Class="Dropshelf.Activities.Notes.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="158"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Note list + new / delete -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox x:Name="NoteList" Grid.Row="0" SelectionMode="Single" SelectionChanged="NoteList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="9,5"/>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextPrimary}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="&#xE710;" Style="{StaticResource IconButton}" ToolTip="New note (Ctrl+N)" Click="New_Click"/>
                <Button x:Name="DeleteButton" Content="&#xE74D;" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                        ToolTip="Delete note" Click="Delete_Click"/>
                <TextBlock x:Name="DeleteHint" Style="{StaticResource TextSecondary}" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Editor -->
        <TextBox x:Name="Editor" Grid.Column="2" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontSize="13" Padding="10,8"
                 TextChanged="Editor_TextChanged" PreviewKeyDown="Editor_PreviewKeyDown"/>
    </Grid>
</UserControl>
