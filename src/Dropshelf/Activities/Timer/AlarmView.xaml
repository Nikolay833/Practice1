<UserControl x:Class="Dropshelf.Activities.Timer.AlarmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- iOS Clock's alarms: a time picker with "Add Alarm" on the left, the alarms with their switches on the right. -->
    <UserControl.Resources>
        <Style x:Key="Chevron" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Capsule" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain text button (the "every day" line, the AM/PM switch) -->
        <Style x:Key="BareText" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="Editor">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Time picker: scroll over the hours or minutes, or use the arrows -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <StackPanel MouseWheel="Hour_MouseWheel" Background="Transparent" Cursor="SizeNS">
                        <Button Content="&#xE70E;" Style="{StaticResource Chevron}" Click="HourUp_Click"/>
                        <TextBlock x:Name="HourText" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Light"
                                   Foreground="{StaticResource TextBrush}" Typography.NumeralAlignment="Tabular" MinWidth="50"
                                   TextAlignment="Right" Margin="0,-6,0,-6"/>
                        <Button Content="&#xE70D;" Style="{StaticResource Chevron}" Click="HourDown_Click"/>
                    </StackPanel>
                    <TextBlock Text=":" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Light"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="2,0,2,4"/>
                    <StackPanel MouseWheel="Minute_MouseWheel" Background="Transparent" Cursor="SizeNS">
                        <Button Content="&#xE70E;" Style="{StaticResource Chevron}" Click="MinuteUp_Click"/>
                        <TextBlock x:Name="MinuteText" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Light"
                                   Foreground="{StaticResource TextBrush}" Typography.NumeralAlignment="Tabular" MinWidth="50"
                                   Margin="0,-6,0,-6"/>
                        <Button Content="&#xE70D;" Style="{StaticResource Chevron}" Click="MinuteDown_Click"/>
                    </StackPanel>
                    <Button x:Name="AmPmButton" Style="{StaticResource BareText}" VerticalAlignment="Center" Margin="6,6,0,0"
                            FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" ToolTip="Switch AM / PM"
                            Click="AmPm_Click"/>
                </StackPanel>
                <Button Content="Add Alarm" Style="{StaticResource Capsule}" Background="#40FF9F0A" Foreground="{StaticResource WarnBrush}"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Click="Add_Click"/>
            </StackPanel>

            <Border Grid.Column="1" Width="1" Margin="14,2" Background="{StaticResource StrokeBrush}"/>

            <!-- The alarms -->
            <Grid Grid.Column="2">
                <TextBlock x:Name="EmptyText" Text="No alarms" Style="{StaticResource TextSecondary}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="List">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Row" Background="Transparent" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="Info">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource DisplayFont}" FontSize="26"
                                                       FontWeight="Light" Foreground="{StaticResource TextBrush}"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Text="{Binding AmPm}" FontSize="13" FontWeight="SemiBold" Margin="3,0,0,4"
                                                       VerticalAlignment="Bottom" Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>
                                        <Button Content="{Binding Detail}" Style="{StaticResource BareText}" FontSize="11"
                                                Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"
                                                ToolTip="Click to switch between once and every day" Click="Repeat_Click"/>
                                    </StackPanel>
                                    <Button x:Name="DeleteButton" Grid.Column="1" Content="&#xE74D;" Style="{StaticResource Chevron}"
                                            Width="24" Height="24" FontSize="11" Margin="0,0,8,0" Visibility="Hidden"
                                            ToolTip="Delete" Click="Delete_Click"/>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"
                                              Focusable="False"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="Info" Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Going off -->
        <Grid x:Name="RingingPanel" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" FontSize="34" Foreground="{StaticResource WarnBrush}"/>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="RingingTime" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Light"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="RingingLabel" Style="{StaticResource TextSecondary}" FontSize="13"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Snooze" Style="{StaticResource Capsule}" Background="{StaticResource FillBrush}"
                        Foreground="{StaticResource TextBrush}" Click="Snooze_Click"/>
                <Button Content="Stop" Style="{StaticResource Capsule}" Background="{StaticResource WarnBrush}"
                        Foreground="{StaticResource BlackBrush}" Margin="8,0,0,0" Click="Stop_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
