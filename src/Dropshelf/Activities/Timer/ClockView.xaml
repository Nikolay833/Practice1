<UserControl x:Class="Dropshelf.Activities.Timer.ClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Clock tab: Alarm, Stopwatch and Timer side by side, like the iPhone's Clock app, behind a small segmented control. -->
    <UserControl.Resources>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="11" Padding="12,3">
                            <ContentPresenter x:Name="Text" HorizontalAlignment="Center"
                                              TextElement.Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#47FFFFFF"/>
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" HorizontalAlignment="Center" Background="#1FFFFFFF" CornerRadius="13" Padding="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AlarmOption" Content="Alarm" Style="{StaticResource Segment}" GroupName="ClockPage" Click="Page_Click"/>
                <RadioButton x:Name="StopwatchOption" Content="Stopwatch" Style="{StaticResource Segment}" GroupName="ClockPage" Click="Page_Click"/>
                <RadioButton x:Name="TimerOption" Content="Timer" Style="{StaticResource Segment}" GroupName="ClockPage" Click="Page_Click"/>
            </StackPanel>
        </Border>

        <Grid x:Name="Pages" Grid.Row="1"/>
    </Grid>
</UserControl>
