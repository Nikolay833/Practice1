<UserControl x:Class="Dropshelf.Activities.Timer.StopwatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- iOS Clock's stopwatch: laps on the left, the time in large digits on the right, Lap / Reset and Start / Stop capsules. -->
    <UserControl.Resources>
        <Style x:Key="Capsule" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Laps, newest first -->
        <ScrollViewer Grid.Column="0" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="2,0,10,6">
            <StackPanel x:Name="LapList"/>
        </ScrollViewer>

        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="LapButton" Content="Lap" Style="{StaticResource Capsule}" Background="{StaticResource FillBrush}"
                    Foreground="{StaticResource TextBrush}" Click="Lap_Click"/>
            <Button x:Name="StartButton" Content="Start" Style="{StaticResource Capsule}" Margin="8,0,0,0" Click="Start_Click"/>
        </StackPanel>

        <TextBlock x:Name="TimeText" Grid.Column="1" Grid.RowSpan="2" FontFamily="{StaticResource DisplayFont}" FontSize="46"
                   FontWeight="Light" Foreground="{StaticResource TextBrush}" Typography.NumeralAlignment="Tabular" Text="00:00.00"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-8"/>
    </Grid>
</UserControl>
