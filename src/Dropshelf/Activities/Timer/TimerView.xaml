<UserControl x:Class="Dropshelf.Activities.Timer.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Capsule button tinted with a colour: a soft fill of it with the colour as text (StandBy's "Start Timer"). -->
        <Style x:Key="TintButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The minute ruler: drag it, scroll over it or click a minute. It fades out at both ends. -->
        <Grid x:Name="RulerHost" Grid.Row="0" Background="Transparent" ClipToBounds="True" Cursor="SizeWE"
              MouseLeftButtonDown="Ruler_MouseLeftButtonDown" MouseMove="Ruler_MouseMove" MouseLeftButtonUp="Ruler_MouseLeftButtonUp"
              MouseWheel="Ruler_MouseWheel" SizeChanged="Ruler_SizeChanged">
            <Grid.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#FF000000" Offset="0.22"/>
                    <GradientStop Color="#FF000000" Offset="0.78"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.OpacityMask>
            <Canvas x:Name="Ruler" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Canvas.RenderTransform>
                    <TranslateTransform x:Name="RulerShift"/>
                </Canvas.RenderTransform>
            </Canvas>
            <!-- The marker under the selected minute -->
            <Path x:Name="Marker" Data="M0,8 L5,0 L10,8 Z" Fill="{StaticResource WarnBrush}" HorizontalAlignment="Center"
                  VerticalAlignment="Top" Margin="0,64,0,0"/>
        </Grid>

        <!-- Start / pause, Pomodoro, cancel on the left; the time on the right -->
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Button x:Name="StartButton" Content="Start Timer" Style="{StaticResource TintButton}" Background="#40FF9F0A"
                        Foreground="{StaticResource WarnBrush}" Click="Start_Click"/>
                <Button x:Name="ResetButton" Content="Cancel" Style="{StaticResource TintButton}" Background="{StaticResource FillBrush}"
                        Foreground="{StaticResource TextBrush}" Margin="8,0,0,0" Click="Reset_Click"/>
                <ToggleButton x:Name="PomodoroToggle" Margin="8,0,0,0" Height="38" Cursor="Hand" Focusable="False"
                              ToolTip="Pomodoro: focus and break rounds (lengths in Settings)" Click="Pomodoro_Click">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{StaticResource FillBrush}" CornerRadius="19" Padding="14,0">
                                <TextBlock x:Name="Label" Text="Pomodoro" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#40FF9F0A"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock x:Name="PhaseText" Style="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Right" Margin="0,0,4,-4"/>
                <TextBlock x:Name="TimeText" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="Light"
                           Foreground="{StaticResource WarnBrush}" Typography.NumeralAlignment="Tabular" Text="15:00"
                           Margin="0,0,0,-8"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
