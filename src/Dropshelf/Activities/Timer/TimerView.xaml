<UserControl x:Class="Dropshelf.Activities.Timer.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Preset chip: a RadioButton drawn as a rounded pill, accent when chosen (same look as the settings segments). -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="11,5" Margin="0,0,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,0,4,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Big ring with the remaining time (the ring itself is added in code) -->
        <Grid x:Name="RingHost" Grid.Column="0" Width="104" Height="104" VerticalAlignment="Center" Margin="6,0,26,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TimeText" Style="{StaticResource TextPrimary}" FontSize="26" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" Text="25:00"/>
                <TextBlock x:Name="PhaseText" Style="{StaticResource TextSecondary}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,1,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel x:Name="Presets" Orientation="Horizontal">
                <RadioButton x:Name="Preset5" Content="5 min" Style="{StaticResource Chip}" GroupName="TimerPreset" Checked="Preset_Checked"/>
                <RadioButton x:Name="Preset10" Content="10 min" Style="{StaticResource Chip}" GroupName="TimerPreset" Checked="Preset_Checked"/>
                <RadioButton x:Name="Preset25" Content="25 min" Style="{StaticResource Chip}" GroupName="TimerPreset" Checked="Preset_Checked"/>
                <RadioButton x:Name="PresetPomodoro" Content="Pomodoro" Style="{StaticResource Chip}" GroupName="TimerPreset" Checked="Preset_Checked"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Custom" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                <TextBox x:Name="CustomBox" Width="82" Padding="8,4" FontSize="13" MaxLength="8" ToolTip="mm:ss, or minutes (e.g. 7:30 or 45)"
                         TextChanged="CustomBox_TextChanged" PreviewKeyDown="CustomBox_PreviewKeyDown"/>
                <TextBlock x:Name="Hint" Style="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="StartButton" Content="Start" Style="{StaticResource AccentButton}" Width="104" Height="30" Click="Start_Click"/>
                <Button x:Name="ResetButton" Content="Reset" Style="{StaticResource TextButton}" Height="30" Margin="8,0,0,0" Click="Reset_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
