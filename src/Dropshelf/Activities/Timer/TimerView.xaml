<UserControl x:Class="Dropshelf.Activities.Timer.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Preset capsule: grey, white with dark text when chosen (iOS-style selection). -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource FillBrush}" CornerRadius="13" Padding="12,5" Margin="0,0,6,0">
                            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="Black"/>
                                <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tinted capsule button like the Clock app's Start / Cancel: a soft fill of the colour with the colour as text. -->
        <Style x:Key="TintButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ring with the remaining time (the ring itself is added in code) -->
        <Grid x:Name="RingHost" Grid.Column="0" Width="104" Height="104" VerticalAlignment="Center" Margin="0,0,24,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TimeText" Style="{StaticResource TextPrimary}" FontFamily="{StaticResource DisplayFont}"
                           FontSize="26" FontWeight="Light" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" Text="25:00"/>
                <TextBlock x:Name="PhaseText" Style="{StaticResource TextSecondary}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,1,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel x:Name="Presets" Orientation="Horizontal">
                <RadioButton x:Name="Preset5" Content="5 min" Style="{StaticResource Chip}" GroupName="TimerPreset" Checked="Preset_Checked"/>
                <RadioButton x:Name="Preset10" Content="10 min" Style="{StaticResource Chip}" GroupName="TimerPreset" Checked="Preset_Checked"/>
                <RadioButton x:Name="Preset25" Content="25 min" Style="{StaticResource Chip}" GroupName="TimerPreset" Checked="Preset_Checked"/>
                <RadioButton x:Name="PresetPomodoro" Content="Pomodoro" Style="{StaticResource Chip}" GroupName="TimerPreset" Checked="Preset_Checked"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Custom" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                <TextBox x:Name="CustomBox" Width="82" Padding="8,4" MaxLength="8" ToolTip="mm:ss, or minutes (e.g. 7:30 or 45)"
                         TextChanged="CustomBox_TextChanged" PreviewKeyDown="CustomBox_PreviewKeyDown"/>
                <TextBlock x:Name="Hint" Style="{StaticResource TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="ResetButton" Content="Cancel" Style="{StaticResource TintButton}" Background="{StaticResource FillBrush}"
                        Foreground="{StaticResource TextBrush}" Click="Reset_Click"/>
                <Button x:Name="StartButton" Content="Start" Style="{StaticResource TintButton}" Background="#4030D158"
                        Foreground="{StaticResource SuccessBrush}" MinWidth="96" Margin="8,0,0,0" Click="Start_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
