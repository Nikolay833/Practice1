<UserControl x:Class="Dropshelf.Animation.MascotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="44" Height="44" IsHitTestVisible="False"
             UseLayoutRounding="False" SnapsToDevicePixels="False">
    <!-- "Drop": a real 3D teardrop (see TeardropMesh) with two white eyes laid over it. The eyes are positioned in
         code from the same yaw/pitch/squash as the 3D body, so they stay glued to the surface as it turns. -->
    <Grid x:Name="Host" Width="44" Height="44">
        <Grid.Effect>
            <DropShadowEffect x:Name="Glow" Color="#FF3B5BFF" BlurRadius="9" ShadowDepth="0" Opacity="0.35"/>
        </Grid.Effect>

        <Viewport3D x:Name="View" ClipToBounds="False" IsHitTestVisible="False">
            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0,6" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="25"/>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight x:Name="Ambient" Color="#FF4A5784"/>
                        <!-- Key light: upper right, in front of the drop -->
                        <DirectionalLight Color="#FFFFFFFF" Direction="-0.45,-0.7,-1"/>
                        <!-- Cool rim light from the lower left gives the glassy edge -->
                        <DirectionalLight x:Name="RimLight" Color="#FF5B7BFF" Direction="0.9,0.35,-0.5"/>
                        <GeometryModel3D x:Name="Body">
                            <GeometryModel3D.Material>
                                <MaterialGroup>
                                    <DiffuseMaterial>
                                        <DiffuseMaterial.Brush>
                                            <!-- v runs from the tip (0) to the belly (1); slightly translucent -->
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop x:Name="StopTip" Color="#EB7DB2FF" Offset="0"/>
                                                <GradientStop x:Name="StopMid" Color="#EB3B82F6" Offset="0.55"/>
                                                <GradientStop x:Name="StopBase" Color="#EB3B5BFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </DiffuseMaterial.Brush>
                                    </DiffuseMaterial>
                                    <SpecularMaterial Brush="White" SpecularPower="60"/>
                                    <EmissiveMaterial x:Name="Emissive" Brush="#503B5BFF"/>
                                </MaterialGroup>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

        <Canvas x:Name="EyeLayer" Width="44" Height="44" IsHitTestVisible="False">
            <Ellipse x:Name="EyeLeft" Fill="White" Width="3.6" Height="6"/>
            <Ellipse x:Name="EyeRight" Fill="White" Width="3.6" Height="6"/>
        </Canvas>
    </Grid>
</UserControl>
