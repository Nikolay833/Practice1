<Window x:Class="Dropshelf.Clipboard.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dropshelf.Clipboard"
        Title="Clipboard history" Width="620" Height="480"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Window.Resources>
        <!-- Rows draw no selection of their own: the GlideBar behind the list moves between them instead. -->
        <Style x:Key="EntryRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type local:ClipboardEntry}">
            <Grid MinHeight="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7" Background="{StaticResource FillBrush}"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Glyph}" FontSize="15"
                                   Foreground="{StaticResource TextBrush}"/>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Width="34" Height="34"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,34,34" RadiusX="7" RadiusY="7"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="1" Text="{Binding Preview}" Style="{StaticResource TextPrimary}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"
                           LineHeight="18" LineStackingStrategy="BlockLineHeight"
                           VerticalAlignment="Center" Margin="12,0,10,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource TextSecondary}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" Click="Pin_Click"
                            ToolTip="Pin / unpin (Ctrl+P)" Focusable="False">
                        <Button.Content>
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE718;"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Text" Value="&#xE840;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Spotlight-style panel: frosted window (see GlassHelper.MakeFrosted), a large search field, a separator and the
         results. The panel springs in (scale + fade); the window itself does not animate. -->
    <Border x:Name="Panel" CornerRadius="12" Background="{StaticResource PanelGlassBrush}" BorderBrush="#26FFFFFF"
            BorderThickness="0.5" RenderTransformOrigin="0.5,0.3">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PanelScale"/>
                <TranslateTransform x:Name="PanelShift"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search -->
            <Grid Grid.Row="0" Height="54" Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="20" FontFamily="{StaticResource DisplayFont}" Padding="10,0,0,0"
                         VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False"
                                          VerticalAlignment="Center" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search Clipboard" Style="{StaticResource TextSecondary}"
                           FontSize="20" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextDisabledBrush}"
                           Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <Border Grid.Row="1" Height="0.5" Background="{StaticResource StrokeBrush}"/>

            <!-- Entries -->
            <Grid x:Name="ListHost" Grid.Row="2" Margin="8,8,8,4" ClipToBounds="True">
                <!-- Selection highlight that glides between rows (position and height are springs, see code-behind) -->
                <Border x:Name="GlideBar" VerticalAlignment="Top" Height="0" Visibility="Collapsed" IsHitTestVisible="False"
                        CornerRadius="8" Background="{DynamicResource AccentBrush}">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="GlideShift"/>
                    </Border.RenderTransform>
                </Border>
                <ListBox x:Name="EntryList" SelectionMode="Single" ItemTemplate="{StaticResource EntryTemplate}"
                         ItemContainerStyle="{StaticResource EntryRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         MouseDoubleClick="EntryList_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock x:Name="EmptyText" Style="{StaticResource TextSecondary}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <!-- Hints -->
            <Border Grid.Row="3" Height="0.5" Background="{StaticResource StrokeBrush}" VerticalAlignment="Top"/>
            <TextBlock Grid.Row="3" Style="{StaticResource TextSecondary}" FontSize="11" Margin="18,8,18,9"
                       Text="&#x2191;&#x2193; Select     &#x21A9; Paste     Ctrl P  Pin     Del  Remove     Esc  Close"/>
        </Grid>
    </Border>
</Window>
