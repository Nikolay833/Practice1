<Window x:Class="Dropshelf.Clipboard.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dropshelf.Clipboard"
        Title="Clipboard history" Width="1100" Height="262"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Window.Resources>
        <!-- A card: the selection is a white outline (no fill), like Droppy's clipboard. -->
        <Style x:Key="CardContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Outline" CornerRadius="15" BorderThickness="2" BorderBrush="Transparent" Padding="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type local:ClipboardEntry}">
            <Border Width="168" Height="148" CornerRadius="12" Background="#FF131315" BorderBrush="#1AFFFFFF" BorderThickness="1"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header band: kind and age, kind icon at the right (a blue pin when pinned) -->
                    <Border Grid.Row="0" Background="#FF1F1F22" CornerRadius="11,11,0,0">
                        <Grid Margin="10,0,8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding KindTitle}" Style="{StaticResource TextPrimary}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource TextSecondary}" FontSize="10"/>
                            </StackPanel>
                            <Border Width="22" Height="22" CornerRadius="11" Background="#26FFFFFF" HorizontalAlignment="Right">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding KindGlyph}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                    <Setter Property="Text" Value="&#xE840;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Body: the text, or the picture -->
                    <TextBlock Grid.Row="1" Text="{Binding Preview}" FontSize="11.5"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="10,8,10,0" LineHeight="15"
                               LineStackingStrategy="BlockLineHeight">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextPrimary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Image Grid.Row="1" Source="{Binding Thumbnail}" Stretch="Uniform" Margin="10,6,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Footer: size or length -->
                    <TextBlock Grid.Row="2" Text="{Binding Details}" Style="{StaticResource TextSecondary}" FontSize="10" FontWeight="SemiBold"
                               Margin="10,4,10,8"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Filter capsule in the toolbar (a coloured dot like Droppy's tags); white-ish fill while chosen. -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{TemplateBinding BorderBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2EFFFFFF"/>
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- A black strip with large rounded corners at the bottom of the screen. It slides up into place. -->
    <Border x:Name="Panel" CornerRadius="22" Background="#F2050506" BorderBrush="{StaticResource GlassRimBrush}" BorderThickness="1"
            RenderTransformOrigin="0.5,1">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PanelScale"/>
                <TranslateTransform x:Name="PanelShift"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: search, then the filters -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,0">
                <Grid Width="170" Margin="0,0,8,0">
                    <Border CornerRadius="12" Background="#1AFFFFFF"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="11" HorizontalAlignment="Left" Margin="10,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="SearchBox" FontSize="12" Margin="26,0,6,0" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <TextBlock x:Name="SearchHint" Text="Search" Style="{StaticResource TextSecondary}" Margin="28,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <RadioButton x:Name="FilterAll" Content="Clipboard" Style="{StaticResource FilterChip}" BorderBrush="#FF8E8E93"
                             GroupName="ClipFilter" IsChecked="True" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterPinned" Content="Pinned" Style="{StaticResource FilterChip}" BorderBrush="#FF0A84FF"
                             GroupName="ClipFilter" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterText" Content="Text" Style="{StaticResource FilterChip}" BorderBrush="#FF30D158"
                             GroupName="ClipFilter" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterImages" Content="Images" Style="{StaticResource FilterChip}" BorderBrush="#FFFF9F0A"
                             GroupName="ClipFilter" Checked="Filter_Checked"/>
                <RadioButton x:Name="FilterFiles" Content="Files" Style="{StaticResource FilterChip}" BorderBrush="#FFFF453A"
                             GroupName="ClipFilter" Checked="Filter_Checked"/>
            </StackPanel>

            <!-- Cards (virtualized: only the visible ones exist) -->
            <Grid Grid.Row="1" Margin="12,4,12,14">
                <ListBox x:Name="EntryList" SelectionMode="Single" ItemTemplate="{StaticResource CardTemplate}"
                         ItemContainerStyle="{StaticResource CardContainer}"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         PreviewMouseWheel="EntryList_PreviewMouseWheel"
                         MouseDoubleClick="EntryList_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Paste" Icon="&#xE77F;" Click="PasteMenu_Click"/>
                            <MenuItem Header="Pin / Unpin" Icon="&#xE718;" InputGestureText="Ctrl+P" Click="PinMenu_Click"/>
                            <Separator/>
                            <MenuItem Header="Delete" Icon="&#xE74D;" InputGestureText="Del" Click="DeleteMenu_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <TextBlock x:Name="EmptyText" Style="{StaticResource TextSecondary}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
