<Window x:Class="Dropshelf.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:act="clr-namespace:Dropshelf.Activities"
        Title="Dropshelf" Width="196" Height="32"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Left="0" Top="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <!-- The window is at least as large as the island (plus the tab capsule under it while open) and is only resized when
         an animation needs more room, and once more when it settles; the island itself is sized inside it every frame.
         Pixels outside the island are fully transparent, so the layered window lets clicks through there. -->
    <Grid VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Island" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="196" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftShoulderColumn" Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightShoulderColumn" Width="6"/>
            </Grid.ColumnDefinitions>

            <!-- Split island: a liquid neck that joins the island to the bubble beside it, so the two read as one shape that is
                 pinching apart (drawn in island coordinates, reaching past its right edge; a Canvas never clips it). -->
            <Canvas Grid.Column="0" Grid.ColumnSpan="3" IsHitTestVisible="False">
                <Path x:Name="Bridge" Fill="{StaticResource BlackBrush}" Visibility="Collapsed"/>
            </Canvas>

            <!-- The concave "shoulders" where the notch flows into the top edge of the screen. They are drawn at 1 x 1 and
                 stretched, so the island can widen them as it opens (small on the closed notch, sweeping when open). -->
            <Path x:Name="LeftShoulder" Grid.Column="0" VerticalAlignment="Top" Width="6" Height="6" Stretch="Fill"
                  Fill="{StaticResource BlackBrush}" Data="M0,0 L1,0 L1,1 A1,1 0 0 0 0,0 Z"/>
            <Path x:Name="RightShoulder" Grid.Column="2" VerticalAlignment="Top" Width="6" Height="6" Stretch="Fill"
                  Fill="{StaticResource BlackBrush}" Data="M1,0 L0,0 L0,1 A1,1 0 0 1 1,0 Z"/>

            <!-- Body: solid black at the top (it is the notch); while open it fades to almost clear at the bottom. -->
            <Border x:Name="Body" Grid.Column="1" CornerRadius="0,0,11,11" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop x:Name="GlassTop" Color="#FF000000" Offset="0"/>
                        <GradientStop x:Name="GlassMid" Color="#FF000000" Offset="0.55"/>
                        <GradientStop x:Name="GlassBottom" Color="#FF000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Compact activity content (now playing, timer, HUDs): leading view at the left edge, trailing view at
                         the right edge, like the Dynamic Island. ApplyLayout sizes this layer to the collapsed island. -->
                    <Grid x:Name="CompactLayer" Width="184" Height="32" VerticalAlignment="Top" HorizontalAlignment="Center"
                          IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="CenterGap" Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <!-- Privacy dot: green while an app uses the camera, orange while one uses the microphone (like iOS). -->
                    <Ellipse x:Name="PrivacyDot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,13,10,0" Visibility="Collapsed" IsHitTestVisible="False"/>

                    <!-- Expanded panel (fixed size; the island clips it while animating). -->
                    <Grid x:Name="ExpandedPanel" Width="720" Height="400" VerticalAlignment="Top" HorizontalAlignment="Center"
                          Opacity="0" Visibility="Hidden" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ExpandedScale"/>
                        </Grid.RenderTransform>

                        <act:CrossfadeHost x:Name="Pages" Margin="26,18,26,20"/>
                        <TextBlock x:Name="EmptyText" Visibility="Collapsed" Style="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="The terminal could not be created"/>

                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- Split island: a second live activity in a small bubble to the right of the island, like the iPhone. -->
        <Grid x:Name="Bubble" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Top" Width="44" Height="32"
              Visibility="Hidden" IsHitTestVisible="False" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BubbleShift"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
            </Grid.ColumnDefinitions>
            <Path x:Name="BubbleLeftShoulder" Grid.Column="0" VerticalAlignment="Top" Width="6" Height="6" Stretch="Fill"
                  Fill="{StaticResource BlackBrush}" Data="M0,0 L1,0 L1,1 A1,1 0 0 0 0,0 Z"/>
            <Path x:Name="BubbleRightShoulder" Grid.Column="2" VerticalAlignment="Top" Width="6" Height="6" Stretch="Fill"
                  Fill="{StaticResource BlackBrush}" Data="M1,0 L0,0 L0,1 A1,1 0 0 1 1,0 Z"/>
            <Border x:Name="BubbleBody" Grid.Column="1" Background="{StaticResource BlackBrush}" CornerRadius="0,0,14,14"/>
        </Grid>

        <!-- Floating tab switcher under the open island: a glass capsule of icon tabs, and a round settings button. -->
        <StackPanel x:Name="Switcher" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                    Opacity="0" Visibility="Hidden" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="SwitcherShift"/>
            </StackPanel.RenderTransform>
            <act:ActivityTabBar x:Name="Tabs" VerticalAlignment="Center"/>
            <Button x:Name="SettingsButton" Style="{StaticResource GlassCircleButton}" Content="&#xE713;" Margin="8,0,0,0"
                    ToolTip="Settings" Click="Settings_Click"/>
            <!-- The transparent island's version: the word, like the plain tab names. -->
            <TextBlock x:Name="SettingsLink" Text="settings" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0"
                       Padding="8,0" Height="30" LineHeight="30" Background="#01000000" Cursor="Hand"
                       FontFamily="Cascadia Mono, Cascadia Code, Consolas, Courier New" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" MouseLeftButtonUp="SettingsLink_Click"
                       MouseEnter="SettingsLink_Hover" MouseLeave="SettingsLink_Hover"/>
        </StackPanel>
    </Grid>
</Window>
