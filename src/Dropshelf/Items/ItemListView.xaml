<UserControl x:Class="Dropshelf.Items.ItemListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dropshelf.Items"
             x:Name="Root">
    <UserControl.Resources>
        <ContextMenu x:Key="ItemMenu" Opened="Menu_Opened" Closed="Menu_Closed">
            <MenuItem Header="Open" Click="Open_Click"/>
            <MenuItem Header="Show in Explorer" Click="ShowInExplorer_Click"/>
            <MenuItem Header="Copy" Click="Copy_Click"/>
            <MenuItem Header="Copy text (OCR)" Tag="ocr" Click="Ocr_Click"/>
            <MenuItem Header="Tools" Tag="tools"/>
            <Separator/>
            <MenuItem Header="Remove" Click="Remove_Click"/>
        </ContextMenu>

        <Style x:Key="TileContainer" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}"/>
            <Setter Property="Padding" Value="4,5"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="ToolTip" Value="{Binding Path}"/>
        </Style>

        <!-- Finder-style icon: the file's icon (or a picture thumbnail with rounded corners) over its name. The
             selection is drawn by the container (a soft rounded highlight), so the tile itself has no chrome. -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:DropItem}">
            <StackPanel Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ItemListView}}}"
                        Background="Transparent" Loaded="Tile_Loaded">
                <Grid Width="48" Height="44" HorizontalAlignment="Center">
                    <!-- Shell icon -->
                    <Image Source="{Binding Icon}" Width="40" Height="40" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThumbnail}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <!-- Picture thumbnail, clipped to a rounded rectangle -->
                    <Image Source="{Binding Icon}" Width="48" Height="40" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,48,40" RadiusX="6" RadiusY="6"/>
                        </Image.Clip>
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThumbnail}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource TextPrimary}" FontSize="11"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="2,4,2,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ListBox x:Name="List" SelectionMode="Extended"
                 ItemContainerStyle="{StaticResource TileContainer}"
                 ItemTemplate="{StaticResource TileTemplate}"
                 PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                 PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                 PreviewMouseMove="List_PreviewMouseMove"
                 PreviewMouseRightButtonDown="List_PreviewMouseRightButtonDown"
                 PreviewMouseWheel="List_PreviewMouseWheel"/>
        <!-- Snapshots of removed tiles shrink and fade out here -->
        <Canvas x:Name="Ghosts" IsHitTestVisible="False" ClipToBounds="True"/>
    </Grid>
</UserControl>
