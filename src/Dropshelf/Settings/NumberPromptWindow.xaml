<Window x:Class="Dropshelf.Settings.NumberPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dropshelf" Width="400" Height="226"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Border Margin="16" CornerRadius="16" Background="#FF141414" BorderBrush="#FF2A2A2A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="22,18,22,16">
            <TextBlock x:Name="TitleText" Style="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock x:Name="HintText" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBox x:Name="Input" Margin="0,12,0,0" FontSize="14" PreviewKeyDown="Input_PreviewKeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Style="{StaticResource TextButton}" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="OkButton" Content="OK" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
