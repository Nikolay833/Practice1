<Window x:Class="Dropshelf.Settings.NumberPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dropshelf" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False" Background="#FF2A2A2C"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <!-- A macOS-style alert with a text field. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="20" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <StackPanel Margin="20,22,20,18">
        <TextBlock x:Name="TitleText" Style="{StaticResource TextPrimary}" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="HintText" Style="{StaticResource TextPrimary}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                   Margin="0,6,0,0" LineHeight="15"/>
        <TextBox x:Name="Input" Margin="0,14,0,0" PreviewKeyDown="Input_PreviewKeyDown" WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="0,5"
                    WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="OkButton" Grid.Column="2" Content="OK" Style="{StaticResource AccentButton}" IsDefault="True"
                    Click="Ok_Click" Padding="0,5" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>
    </StackPanel>
</Window>
