<Window x:Class="Dropshelf.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dropshelf Settings" Width="476" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource TextSecondary}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,12,0,6"/>
        </Style>

        <!-- Segmented choice (Full / Subtle / Off) built from RadioButtons. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#FF262626" CornerRadius="7" Padding="12,5" Margin="3,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="#FF262626"/>
            <Setter Property="BorderBrush" Value="#FF363636"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="16" Background="#FF141414" BorderBrush="#FF2A2A2A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Height="52" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Settings" Style="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="22,0,0,0"/>
                <Button Content="&#xE711;" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Close" Click="Close_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,0,0">
                <StackPanel Margin="20,0,20,20">

                    <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" Margin="4,0,0,6"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Launch at startup" Style="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Start Dropshelf when you sign in to Windows" Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </CheckBox>
                            <TextBlock x:Name="AutoStartStatus" Style="{StaticResource TextSecondary}" FontSize="11"
                                       TextWrapping="Wrap" Margin="26,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Install location" Style="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="InstallPath" Style="{StaticResource TextSecondary}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ANIMATIONS" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Animations" Style="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton x:Name="AnimFull" Content="Full" Tag="Full" GroupName="Animations"
                                                 Style="{StaticResource Segment}" Checked="Animation_Checked"/>
                                    <RadioButton x:Name="AnimSubtle" Content="Subtle" Tag="Subtle" GroupName="Animations"
                                                 Style="{StaticResource Segment}" Checked="Animation_Checked"/>
                                    <RadioButton x:Name="AnimOff" Content="Off" Tag="Off" GroupName="Animations"
                                                 Style="{StaticResource Segment}" Checked="Animation_Checked"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="AnimationHint" Style="{StaticResource TextSecondary}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SHELF" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <CheckBox IsChecked="{Binding RememberShelf, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Remember shelf items" Style="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Keep what is on the shelf after a restart" Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <CheckBox IsChecked="{Binding ExpandShelfOnHover, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Expand shelf on hover" Style="{StaticResource TextPrimary}"/>
                                <TextBlock Text="When off, the shelf opens only when you drag over it or click it" Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Text="BASKET" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <CheckBox IsChecked="{Binding ShakeToOpenBasket, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Shake to open basket" Style="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Shake the mouse left and right while dragging" Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Text="CLIPBOARD" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <CheckBox IsChecked="{Binding ClipboardHistoryEnabled, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="Clipboard history" Style="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Remember text, images and files you copy" Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding ClipboardHistoryEnabled}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="History size" Style="{StaticResource TextPrimary}"/>
                                <TextBlock Text="{Binding ClipboardHistorySize, StringFormat={}{0} entries}"
                                           Style="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="10" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True"
                                    SmallChange="10" LargeChange="50" Margin="0,10,0,0"
                                    Value="{Binding ClipboardHistorySize, Mode=TwoWay}"/>
                            <TextBlock Text="Pinned entries are never removed" Style="{StaticResource TextSecondary}"
                                       FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="HOTKEYS" Style="{StaticResource SectionLabel}"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Open basket" Style="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right">
                                    <TextBlock Text="Ctrl + Shift + B" Style="{StaticResource TextSecondary}"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="Clipboard history" Style="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource KeyCap}" HorizontalAlignment="Right">
                                    <TextBlock Text="Ctrl + Shift + V" Style="{StaticResource TextSecondary}"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Content="Open data folder" Style="{StaticResource TextButton}" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Click="OpenFolder_Click"/>
                    <TextBlock Style="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="8,6,0,0"
                               Text="Dropshelf is an independent Windows app. It is not affiliated with any macOS product."/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
