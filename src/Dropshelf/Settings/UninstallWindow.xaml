<Window x:Class="Dropshelf.Settings.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Dropshelf" Width="456" Height="296"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Border Margin="16" CornerRadius="16" Background="#FF141414" BorderBrush="#FF2A2A2A" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel Margin="22,20,22,18">
            <TextBlock Text="Uninstall Dropshelf?" Style="{StaticResource TextPrimary}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="19"
                       Text="Dropshelf will stop starting with Windows, its Start Menu shortcut will be removed, and the installed app will be deleted after it quits."/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="16,12" Margin="0,14,0,0">
                <CheckBox x:Name="DeleteDataCheck">
                    <StackPanel>
                        <TextBlock Text="Also delete my shelf &amp; clipboard data" Style="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Leave this off to keep your data if you reinstall later" Style="{StaticResource TextSecondary}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Style="{StaticResource TextButton}" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Uninstall" Style="{StaticResource AccentButton}" Click="Uninstall_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
