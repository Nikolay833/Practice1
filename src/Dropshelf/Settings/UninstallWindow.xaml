<Window x:Class="Dropshelf.Settings.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Dropshelf" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False" Background="#FF2A2A2C"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <!-- A macOS-style alert: app icon, bold centred title, message, two equal buttons. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="20" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <StackPanel Margin="20,22,20,18">
        <Image Source="pack://application:,,,/Assets/app.ico" Width="56" Height="56" HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Uninstall Dropshelf?" Style="{StaticResource TextPrimary}" FontWeight="Bold" Margin="0,14,0,0"
                   HorizontalAlignment="Center"/>
        <TextBlock Style="{StaticResource TextPrimary}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                   LineHeight="15" Text="Dropshelf will stop starting with Windows, its Start Menu shortcut will be removed, and the app will be deleted after it quits."/>
        <CheckBox x:Name="DeleteDataCheck" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Also delete my data" Style="{StaticResource TextPrimary}" FontSize="12"/>
                <TextBlock Text="Basket, clipboard history, notes and settings" Style="{StaticResource TextSecondary}" FontSize="11"
                           Margin="0,1,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </CheckBox>
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancel" IsCancel="True" Click="Cancel_Click" Padding="0,5"
                    WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Grid.Column="2" Content="Uninstall" Click="Uninstall_Click" Padding="0,5" Foreground="{StaticResource DangerBrush}"
                    WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>
    </StackPanel>
</Window>
