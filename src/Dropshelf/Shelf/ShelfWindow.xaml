<Window x:Class="Dropshelf.Shelf.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dropshelf.Shelf"
        Title="Dropshelf" Width="200" Height="32"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        WindowStartupLocation="Manual" Left="0" Top="0" AllowDrop="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Border x:Name="Pill" Background="{StaticResource BlackBrush}" BorderBrush="{StaticResource PillBorderBrush}"
            BorderThickness="1,0,1,1" CornerRadius="0,0,14,14" ClipToBounds="True">
        <Grid>
            <!-- Collapsed notch content: item count badge -->
            <Grid x:Name="CollapsedLayer" Width="200" Height="32" VerticalAlignment="Top"
                  HorizontalAlignment="Center" IsHitTestVisible="False">
                <Border x:Name="Badge" Visibility="Collapsed" Background="{StaticResource AccentBrush}"
                        CornerRadius="9" MinWidth="18" Height="18" Padding="6,0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeText" Style="{StaticResource TextPrimary}" FontSize="11"
                               FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Expanded shelf panel (fixed size; the pill clips it while animating) -->
            <Grid x:Name="ExpandedPanel" Width="640" Height="180" VerticalAlignment="Top" HorizontalAlignment="Center"
                  Opacity="0" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,12,10,0" Height="28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Shelf" Style="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CountText" Style="{StaticResource TextSecondary}" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ClearButton" Content="Clear all" Style="{StaticResource TextButton}"
                                Click="Clear_Click" VerticalAlignment="Center"/>
                        <Button Content="&#xE713;" Style="{StaticResource IconButton}" Margin="2,0,0,0"
                                ToolTip="Settings" Click="Settings_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="14,6,14,14">
                    <!-- Empty state -->
                    <Grid x:Name="EmptyState" IsHitTestVisible="False">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="#FF3A3A3A" StrokeThickness="1.5"
                                   StrokeDashArray="4 4" SnapsToDevicePixels="False"/>
                        <TextBlock Text="Drop files here" Style="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                    </Grid>

                    <local:ItemListView x:Name="ItemsView"/>

                    <!-- Drag-over highlight -->
                    <Border x:Name="DropHighlight" Visibility="Collapsed" IsHitTestVisible="False"
                            CornerRadius="14" BorderThickness="1.5" BorderBrush="{StaticResource AccentBrush}"
                            Background="#143B82F6"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
